npm init -y
npm install axios systeminformation dotenv

nano .env
SERVER_ID=Prod-2
BACKEND_URL=http://65.2.140.66/api/metrics
ctrl o enter ctrl x

nano agent.js
require("dotenv").config();

console.log("🚀 Agent started...");

const si = require("systeminformation");
const axios = require("axios");

// ✅ From .env
const SERVER_ID = process.env.SERVER_ID;
const BACKEND_URL = process.env.BACKEND_URL;
const API_URL = process.env.API_URL;

let pollingInterval = 5000;
let metricsLoop;

// 🔥 Fetch polling config from backend
async function fetchPollingConfig() {

  try {

    const res = await axios.get(
      `${API_URL}/api/config/system`
    );

    const config = res.data;

    const newInterval =
      config.pollingInterval * 1000;

    // restart only if changed
    if (newInterval !== pollingInterval) {

      pollingInterval = newInterval;

      console.log(
        `⏱️ Polling interval updated to ${config.pollingInterval}s`
      );

      restartMetricsLoop();
    }

  } catch (err) {

    console.log(
      "⚠️ Failed to fetch polling config"
    );
  }
}

// 🔥 Restart interval loop
function restartMetricsLoop() {

  if (metricsLoop) {
    clearInterval(metricsLoop);
  }

  metricsLoop = setInterval(() => {
    sendMetrics();
  }, pollingInterval);
}

// 🔥 Collect metrics
async function getMetrics() {

  try {

    console.log("📊 Collecting metrics...");

    const cpu = await si.currentLoad();
    const mem = await si.mem();
    const disk = await si.fsSize();
    const uptime = await si.time();

    let network = [];
    let processes = {};

    // network
    try {
      network = await si.networkStats();
    } catch (err) {
      console.log("⚠️ Network error:", err.message);
    }

    // processes
    try {
      processes = await si.processes();
    } catch (err) {
      console.log("⚠️ Process error:", err.message);
    }

    return {

      serverId: SERVER_ID,

      cpu: cpu.currentLoad,

      ramUsed: mem.used,
      ramTotal: mem.total,

      diskUsed: disk[0]?.used || 0,
      diskTotal: disk[0]?.size || 0,

      uptime: uptime.uptime,

      networkIn: network[0]?.rx_sec || 0,
      networkOut: network[0]?.tx_sec || 0,

      totalProcesses: processes?.all || 0
    };

  } catch (err) {

    console.error("🔥 METRICS CRASH:", err.message);
  }
}

// 🔥 Send metrics to backend
async function sendMetrics() {

  try {

    const data = await getMetrics();

    if (!data) return;

    await axios.post(BACKEND_URL, data);

    console.log(
      `📡 ${SERVER_ID} → ${data.cpu.toFixed(2)}% CPU sent`
    );

  } catch (err) {

    console.error(
      "❌ SEND ERROR:",
      err.message
    );
  }
}

// 🔥 Start loop
restartMetricsLoop();

// 🔥 Refresh config every 10 sec
setInterval(fetchPollingConfig, 10000);

// 🔥 Initial config fetch
fetchPollingConfig();

